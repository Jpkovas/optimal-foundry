<div class="of-settings-body of-welcome-body scrollable">
    <p class="of-welcome-lead">{{localize "OPTIMALFOUNDRY.Welcome.Lead"}} <i class="fa-regular fa-circle-question of-hint" data-tooltip="{{localize "OPTIMALFOUNDRY.Welcome.Intro"}}" aria-label="{{localize "OPTIMALFOUNDRY.Welcome.Intro"}}"></i></p>

    <h3 class="of-title"><i class="fa-solid fa-wand-magic-sparkles" inert></i> {{localize "OPTIMALFOUNDRY.Welcome.PresetTitle"}}
        <i class="fa-regular fa-circle-question of-hint" data-tooltip="{{localize "OPTIMALFOUNDRY.Welcome.PresetHint"}}" aria-label="{{localize "OPTIMALFOUNDRY.Welcome.PresetHint"}}"></i>
        {{#if keepCurrent}}<span class="of-chip warn" data-tooltip="{{localize "OPTIMALFOUNDRY.Welcome.KeepCurrentHint"}}"><i class="fa-solid fa-pen" inert></i> {{localize "OPTIMALFOUNDRY.Welcome.KeepCurrent"}}</span>{{/if}}
    </h3>
    <div class="of-presets of-choices">
        {{#each presets}}
        <label class="of-preset of-choice" data-tooltip="{{hint}}">
            <input type="radio" name="preset" value="{{id}}" {{#if checked}}checked{{/if}}>
            <i class="{{icon}}" inert></i>
            <strong>{{label}}</strong>
        </label>
        {{/each}}
    </div>

    <h3 class="of-title" data-of-media><i class="fa-solid fa-photo-film" inert></i> {{localize "OPTIMALFOUNDRY.Welcome.ModeTitle"}}
        <i class="fa-regular fa-circle-question of-hint" data-tooltip="{{localize "OPTIMALFOUNDRY.Welcome.ModeHint"}}" aria-label="{{localize "OPTIMALFOUNDRY.Welcome.ModeHint"}}"></i>
    </h3>
    <div class="of-modes of-choices" data-of-media>
        {{#each modes}}
        <label class="of-preset of-choice" data-tooltip="{{hint}}">
            <input type="radio" name="backfillMode" value="{{id}}" {{#if checked}}checked{{/if}}>
            <i class="{{icon}}" inert></i>
            <strong>{{label}}</strong>
        </label>
        {{/each}}
    </div>

    <h3 class="of-title"><i class="fa-solid fa-toggle-on" inert></i> {{localize "OPTIMALFOUNDRY.Welcome.FeaturesTitle"}}</h3>
    <div class="of-switches">
        {{#each switches}}
        <label class="of-switch" {{#if media}}data-of-media{{/if}} data-tooltip="{{localize hint}}">
            <i class="{{icon}}" inert></i>
            <span>{{localize name}}</span>
            <input type="checkbox" name="{{key}}" {{#if checked}}checked{{/if}}>
        </label>
        {{/each}}
    </div>
    <div class="form-group of-welcome-upload">
        <label for="of-welcome-upload"><i class="fa-solid fa-arrow-up-from-bracket" inert></i> {{localize "OPTIMALFOUNDRY.Settings.hostUploadMbps.Name"}}
            <i class="fa-regular fa-circle-question of-hint" data-tooltip="{{localize "OPTIMALFOUNDRY.Welcome.UploadHint"}}" aria-label="{{localize "OPTIMALFOUNDRY.Welcome.UploadHint"}}"></i></label>
        <div class="form-fields"><range-picker id="of-welcome-upload" name="hostUploadMbps" value="{{upload.value}}" min="{{upload.min}}" max="{{upload.max}}" step="{{upload.step}}"></range-picker></div>
    </div>

    <p class="of-muted of-welcome-outro"><i class="fa-solid fa-shield-halved" inert></i> {{localize "OPTIMALFOUNDRY.Welcome.OutroShort"}}
        <i class="fa-regular fa-circle-question of-hint" data-tooltip="{{localize "OPTIMALFOUNDRY.Welcome.Outro"}}" aria-label="{{localize "OPTIMALFOUNDRY.Welcome.Outro"}}"></i></p>
</div>
