<section class="tab of-tab {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{#with p2p}}
    {{#if blocker}}<p class="of-note warn"><i class="fa-solid fa-lock-open" inert></i> {{blocker}}</p>{{/if}}

    {{#if overview}}
    <h3 class="of-title"><i class="fa-solid fa-share-nodes" inert></i> {{localize "OPTIMALFOUNDRY.Sharing.Title"}} <i class="fa-regular fa-circle-question of-hint" data-tooltip="{{localize "OPTIMALFOUNDRY.Sharing.Intro"}}" aria-label="{{localize "OPTIMALFOUNDRY.Sharing.Intro"}}"></i></h3>
    <dl class="of-kv">
        <dt>{{localize "OPTIMALFOUNDRY.Dashboard.Media.State"}}</dt><dd><span class="of-chip {{overview.cls}}">{{overview.label}}</span></dd>
        {{#if overview.on}}
        <dt>{{localize "OPTIMALFOUNDRY.Sharing.Moved"}}</dt><dd>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Sent"}} {{overview.up}} · {{localize "OPTIMALFOUNDRY.Dashboard.P2P.Received"}} {{overview.down}}</dd>
        {{/if}}
    </dl>
    {{#if overview.reason}}<p class="of-note">{{overview.reason}}</p>{{/if}}
    {{/if}}

    <h3 class="of-title"><i class="fa-solid fa-box-archive" inert></i> {{localize "OPTIMALFOUNDRY.Dashboard.P2P.LocalCache"}}</h3>
    {{#if cache}}
    <dl class="of-kv">
        <dt>{{localize "OPTIMALFOUNDRY.Dashboard.Media.State"}}</dt><dd><span class="of-chip {{#if cache.active}}ok{{else}}idle{{/if}}">{{#if cache.active}}{{localize "OPTIMALFOUNDRY.Dashboard.P2P.CacheActive"}}{{else}}{{localize "OPTIMALFOUNDRY.Dashboard.P2P.CacheInactive"}}{{/if}}</span></dd>
        {{#if cache.active}}
        <dt>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Cache"}}</dt><dd>{{cache.cachedFiles}} · {{cache.cachedBytes}} / {{cache.quota}}</dd>
        <dt>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Persisted"}}</dt><dd>{{cache.persisted}}</dd>
        {{/if}}
    </dl>
    {{#if cache.reason}}<p class="of-note">{{cache.reason}}</p>{{/if}}
    {{else}}
    <p class="of-muted">{{localize "OPTIMALFOUNDRY.Dashboard.Common.Unavailable"}}</p>
    {{/if}}

    <h3 class="of-title"><i class="fa-solid fa-laptop" inert></i> {{localize "OPTIMALFOUNDRY.Dashboard.P2P.Swarm"}}</h3>
    {{#if swarm}}
    <dl class="of-kv">
        <dt>{{localize "OPTIMALFOUNDRY.Dashboard.Media.State"}}</dt><dd>{{swarm.stateLabel}}</dd>
        <dt>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Sent"}}</dt><dd>{{swarm.up}} · {{swarm.servedFiles}} {{localize "OPTIMALFOUNDRY.Dashboard.P2P.Files"}}</dd>
        <dt>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Received"}}</dt><dd>{{swarm.down}} · {{swarm.fetchedFiles}} {{localize "OPTIMALFOUNDRY.Dashboard.P2P.Files"}}</dd>
        <dt>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Failures"}}</dt><dd>{{swarm.failures}}</dd>
        <dt>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Participate"}}</dt><dd>{{participate}} · {{localize "OPTIMALFOUNDRY.Dashboard.P2P.UploadCap"}}: {{uploadCap}}</dd>
    </dl>
    {{#if swarm.reason}}<p class="of-note">{{swarm.reason}}</p>{{/if}}
    {{#if swarm.lastFailure}}<p class="of-muted" data-tooltip-text="{{swarm.lastFailureDetail}}">{{swarm.lastFailure}}</p>{{/if}}
    {{else}}
    <p class="of-muted">{{localize "OPTIMALFOUNDRY.Dashboard.Common.Unavailable"}}</p>
    {{/if}}

    <h3 class="of-title"><i class="fa-solid fa-users" inert></i> {{localize "OPTIMALFOUNDRY.Dashboard.P2P.Peers"}}</h3>
    {{#if hasPeers}}
    <table class="of-table">
        <thead>
            <tr>
                <th>{{localize "OPTIMALFOUNDRY.Dashboard.Network.Player"}}</th>
                <th>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Connection"}}</th>
                <th>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Rtt"}}</th>
                <th>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Sent"}}</th>
                <th>{{localize "OPTIMALFOUNDRY.Dashboard.P2P.Received"}}</th>
            </tr>
        </thead>
        <tbody>
            {{#each peers}}
            <tr>
                <td>{{name}}</td>
                <td><span class="of-chip {{#if connected}}ok{{else}}idle{{/if}}">{{state}}</span></td>
                <td>{{rtt}}</td>
                <td>{{up}}</td>
                <td>{{down}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    {{else}}
    <p class="of-muted">{{localize "OPTIMALFOUNDRY.Dashboard.P2P.NoPeers"}}</p>
    {{/if}}
    {{/with}}
</section>
